{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        ;; Native Image feature, enabled in bb.edn.
        com.github.clj-easy/graal-build-time {:mvn/version "1.0.6"}}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
